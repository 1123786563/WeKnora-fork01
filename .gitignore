data/files/
data/weknora.db
data/weknora.db-wal
data/weknora.db-shm
skills-lock.json

/web/
*.tsbuildinfo

# React apps build output (previously swallowed by the bare web/ rule)
apps/web/dist/
apps/embed/dist/
apps/desktop/dist/
apps/mobile/dist-ios/
apps/mobile/dist-android/

**/__pycache__
/scripts/scale_dev_jobs.sh
/server
frontend/.vite
frontend/chrome-extension/
WeKnora-Chrome-Extension
packages/protoc-3.19.4-linux-x86_64.zip

Claude.md

# 本地测试脚本
configure-ollama.sh
fix-docker.sh

# WeChat Mini Program local/private configuration
miniprogram/project.private.config.json

# Staging dir for the Docker sandbox self-check probe (removed after each run)
.weknora-sandbox-check-*



# Local-only sandbox evidence: ids, payer data, signed requests, keys
artifacts/
DSH_*.txt
tests/mobile-v2/fixtures/*.bin
android/
ios/

# apps/mobile（vendored Conduit 快照）整体重新包含：
# 上方若干历史裸目录模式（ios/、android/、services/、models/、providers/ 等）
# 会误伤快照内的同名目录；嵌套的 apps/mobile/.gitignore 仍继续排除
# .dart_tool/、build/ 等构建产物（更深层规则优先）。
!apps/mobile/
!apps/mobile/**
.mimosa/
parity-audit/
