# Template for the pinned local Lago Community v1.53.0 environment.
#
# Do NOT fill this in by hand and do NOT commit real values.
# `./deploy/lago/lago.sh init` generates the real `.env` next to this file
# with cryptographically random secrets and mode 600.
#
# Safe per-worktree overrides (all optional):
#   COMPOSE_PROJECT_NAME  isolated Compose project name (default: weknora-lago)
#   LAGO_API_PORT         host loopback port for the API (default: 48889)
#   LAGO_FRONT_PORT       host loopback port for the frontend (default: 48890)

COMPOSE_PROJECT_NAME=weknora-lago
LAGO_API_PORT=48889
LAGO_FRONT_PORT=48890
LAGO_API_URL=http://127.0.0.1:48889
LAGO_FRONT_URL=http://127.0.0.1:48890

# Required secrets -- generated by `lago.sh init`; must differ from the
# official Lago sample defaults. Never commit, log, or paste these values.
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
LAGO_ENCRYPTION_PRIMARY_KEY=
LAGO_ENCRYPTION_DETERMINISTIC_KEY=
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=
LAGO_RSA_PRIVATE_KEY=
