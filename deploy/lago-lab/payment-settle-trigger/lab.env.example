# t11 settle-trigger lab: caller-supplied values ONLY (never committed).
# The lab stack's own secrets are generated by ./lab.sh init into lab.env
# (mode 600, git-ignored). The Stripe TEST key is sourced in the shell from
# the operator secret store -- never written to a file in this repo.

# Stripe test-mode secret key (sk_test_.../rk_test_... only; live refused).
# source ~/.zcode/issue72-stripe.env  (or your own equivalent)
STRIPE_SECRET_KEY=__SET_IN_SHELL__

# Optional: override the settle payment-method token (default pm_card_visa).
# Public Stripe test token, overridable for the Task 10 topology.
LAB_SETTLE_PM=__SET_IN_SHELL__
