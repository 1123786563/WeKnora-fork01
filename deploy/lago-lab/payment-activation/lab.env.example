# Example shape of the git-ignored lab.env generated by `lab.sh init`.
# Every value below is a placeholder; real secrets are generated locally and
# never committed. Delete this file's real counterpart to regenerate.
COMPOSE_PROJECT_NAME=weknora-lago-74
LAGO_API_PORT=48891
LAGO_FRONT_PORT=48892
LAGO_API_URL=http://127.0.0.1:48891
LAGO_FRONT_URL=http://127.0.0.1:48892
POSTGRES_PASSWORD=<generated>
SECRET_KEY_BASE=<generated-hex>
LAGO_ENCRYPTION_PRIMARY_KEY=<generated>
LAGO_ENCRYPTION_DETERMINISTIC_KEY=<generated>
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=<generated>
LAGO_RSA_PRIVATE_KEY=<generated-openssl-base64>
# One-shot seed consumed by the compose `migrate` service on first `up`
# (creates the operator account and mints the organization API key).
LAGO_CREATE_ORG=true
LAGO_ORG_USER_EMAIL=ops-t02@weknora.local
LAGO_ORG_USER_PASSWORD=<generated>
LAGO_ORG_NAME=WeKnora T02 Lab
LAGO_ORG_API_KEY=<generated>
# LAGO_LICENSE deliberately absent: the lab runs Community without a license.
