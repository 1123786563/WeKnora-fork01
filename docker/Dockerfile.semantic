# Semantica semantic service (O01).
# Runtime pinned; deps come from the V01-frozen uv lock. Secrets are
# NEVER baked in - only references at runtime.
FROM python:3.12.13-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

WORKDIR /service
COPY semantic/pyproject.toml semantic/uv.lock ./
RUN pip install --no-cache-dir uv==0.5.24 && uv sync --frozen --no-dev

COPY semantic/semantic_service ./semantic_service
COPY semantic/rules ./rules
COPY semantic/migrations ./migrations

# API entry (gRPC server + probes). The worker entry reuses the image
# with a different command (compose/helm select the entry).
EXPOSE 50051
# Run the frozen venv python DIRECTLY: uv run would re-sync with default
# groups at boot (installing dev deps / requiring PyPI egress offline).
ENTRYPOINT ["/service/.venv/bin/python", "-m", "semantic_service.server_entry"]