+	if record.Scope.TenantID != scope.TenantID || record.Scope.UserID != scope.UserID || record.Scope.SessionID != scope.SessionID {
+		return craft.KnowledgeRecord{}, craft.ErrForbidden
+	}
+	return record, nil
