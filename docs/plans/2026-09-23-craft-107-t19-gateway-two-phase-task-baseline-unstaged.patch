+		env := newCraftGatewayTestEnv(t)
+		credential, _ := issueCredentialOn(t, env, craftGatewayIssueBody)
+		forwardCalls := 0
+		env.gw.forward = func(*http.Request) (*http.Response, error) {
+			forwardCalls++
