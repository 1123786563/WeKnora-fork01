+// every visited directory. It is used at list/read boundaries so a mutation in
+// an unrelated sibling cannot be hidden by reading an unchanged requested
+// file. This detects observed drift; it is not an atomic filesystem snapshot.
+func verifyRunBoundArtifactTreeSnapshot(rootFD int, listed map[string]runBoundArtifactIdentity) error {
+	entryCount := 0
+	return verifyRunBoundArtifactDirectory(rootFD, "", -1, "", listed, &entryCount)
+}
