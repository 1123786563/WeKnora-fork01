+func TestCraftRunViewR4RunBoundArtifactSourceRevalidatesEveryDirectory(t *testing.T) {
+	t.Run("list catches previously visited nested directory drift", func(t *testing.T) {
+		f := newR4SeedExecuteFixture(t, nil, 3, nil, false)
+		visited := filepath.Join(f.material.output, "a-visited")
+		later := filepath.Join(f.material.output, "z-later")
+		require.NoError(t, os.Mkdir(visited, 0o755))
+		require.NoError(t, os.Mkdir(later, 0o755))
+		require.NoError(t, os.WriteFile(filepath.Join(visited, "before.txt"), []byte("before"), 0o644))
+		require.NoError(t, os.WriteFile(filepath.Join(later, "later.txt"), []byte("later"), 0o644))
+		source, err := newRunBoundCraftArtifactSource(context.Background(), f.runtime, f.task, f.material, craftLocalOutputDir)
+		require.NoError(t, err)
+		var changed atomic.Bool
+		source.afterDirectoryRead = func(rel string) {
+			if rel == "z-later" && changed.CompareAndSwap(false, true) {
+				require.NoError(t, os.WriteFile(filepath.Join(visited, "inserted.txt"), []byte("late"), 0o644))
+			}
+		}
+		_, err = source.ListSessionFiles(context.Background(), f.task.Scope.SessionID, craftLocalOutputDir)
+		require.ErrorIs(t, err, craft.ErrConflict)
+	})
+
+	for _, mutation := range []string{"insert", "remove", "rename"} {
+		t.Run("read catches unrelated sibling "+mutation, func(t *testing.T) {
+			f := newR4SeedExecuteFixture(t, nil, 3, nil, false)
+			assets := filepath.Join(f.material.output, "assets")
+			other := filepath.Join(f.material.output, "other")
+			require.NoError(t, os.Mkdir(assets, 0o755))
+			require.NoError(t, os.Mkdir(other, 0o755))
+			require.NoError(t, os.WriteFile(filepath.Join(assets, "app.js"), []byte("unchanged"), 0o644))
+			require.NoError(t, os.WriteFile(filepath.Join(other, "sibling.txt"), []byte("sibling"), 0o644))
+			source, err := newRunBoundCraftArtifactSource(context.Background(), f.runtime, f.task, f.material, craftLocalOutputDir)
+			require.NoError(t, err)
+			_, err = source.ListSessionFiles(context.Background(), f.task.Scope.SessionID, craftLocalOutputDir)
+			require.NoError(t, err)
+			switch mutation {
+			case "insert":
+				require.NoError(t, os.WriteFile(filepath.Join(other, "inserted.txt"), []byte("late"), 0o644))
+			case "remove":
+				require.NoError(t, os.Remove(filepath.Join(other, "sibling.txt")))
+			case "rename":
+				require.NoError(t, os.Rename(filepath.Join(other, "sibling.txt"), filepath.Join(other, "renamed.txt")))
+			}
+			_, err = source.ReadSessionFile(context.Background(), f.task.Scope.SessionID, "output/assets/app.js")
 			require.ErrorIs(t, err, craft.ErrConflict)
 		})
 	}
