+func runViewDirectoryStatMatches(identity craftRunViewLayoutIdentity, path string, stat unix.Stat_t) bool {
+	for _, dir := range identity.Directories {
+		if dir.Path == path {
+			return dir.Device == uint64(stat.Dev) && dir.Inode == uint64(stat.Ino)
+		}
+	}
+	return false
+}
