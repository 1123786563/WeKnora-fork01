+    if op == "begin_phase" and mode is None:
+        raise ValueError("begin_phase requires a mode")
+    operation_id, controller_ordinal = identity or _next_controller_identity(op, phase_id)
+    send = send_source or _send_source_command
+    cursors = {}
+    for source in ("direct", "adapter"):
+        request = {
+            "ordinal": _next_source_ordinal(source), "op": op, "phase_id": phase_id,
+            "operation_id": operation_id, "controller_ordinal": controller_ordinal,
+        }
+        if op == "begin_phase":
+            request["mode"] = mode
+        response = send(source, request)
+        if not isinstance(response, dict) or response.get("ok") is not True or response.get("source") != source or response.get("phase_id") != phase_id:
+            raise RuntimeError(f"{source} {op} acknowledgment identity mismatch")
+        if response.get("operation_id") != operation_id or response.get("controller_ordinal") != controller_ordinal:
+            raise RuntimeError(f"{source} {op} acknowledgment controller identity mismatch")
+        cursor = response.get("stream_cursor")
+        if type(cursor) is not int or cursor <= 0:
+            raise RuntimeError(f"{source} {op} acknowledgment lacks a valid stream cursor")
+        cursors[source] = cursor
