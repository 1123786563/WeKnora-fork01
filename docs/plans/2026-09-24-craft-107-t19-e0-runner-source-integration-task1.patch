+        "ordinal": int(manifest.get("phase_command_ordinal", 0)) + 1,
+        "controller_ordinal": controller_ordinal, "operation_id": operation_id,
+        "op": op, "phase_id": phase_id, "source_cursors": cursors,
+    }
+    if op == "begin_phase":
+        row["mode"] = mode
+        if mode == "control":
