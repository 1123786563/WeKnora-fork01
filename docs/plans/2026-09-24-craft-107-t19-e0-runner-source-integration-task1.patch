+def _validate_helper_start_ack(source, response, phase_id, operation_id, controller_ordinal):
+    expected = {
+        "ok": True,
+        "source": source,
+        "phase_id": phase_id,
+        "boundary": "helper_start",
+        "operation_id": operation_id,
+        "controller_ordinal": controller_ordinal,
+    }
+    if not isinstance(response, dict) or any(response.get(key) != value for key, value in expected.items()):
+        raise RuntimeError(f"{source} helper-start acknowledgment identity mismatch")
+    cursor = response.get("stream_cursor")
+    if type(cursor) is not int or cursor <= 0:
+        raise RuntimeError(f"{source} helper-start acknowledgment lacks a valid fsynced cursor")
+    return cursor
+
