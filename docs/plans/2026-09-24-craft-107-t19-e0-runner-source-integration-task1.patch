+def source_evidence_mount(source, volume_name):
+    """Return one source-private evidence mount; never share a writable source volume."""
+    if source not in {"direct", "adapter"}:
+        raise ValueError(f"unknown source recorder: {source}")
+    if not isinstance(volume_name, str) or not volume_name.strip():
+        raise ValueError("source evidence volume name is required")
+    return ["--mount", f"type=volume,source={volume_name},target=/evidence"]
+
+
+def helper_container_argv(name, network, image):
+    """Create an idle helper with network access and no recorder/control mounts."""
+    if not all(isinstance(value, str) and value for value in (name, network, image)):
+        raise ValueError("helper container name, network and image are required")
+    return ["docker", "run", "-d", "--name", name, "--network", network,
+            "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
+            "--entrypoint", "sleep", image, "infinity"]
+
+
+def _send_source_command(source, request, timeout=8):
+    if source not in {"direct", "adapter"}:
+        raise ValueError(f"unknown source recorder: {source}")
+    socket_client = (
+        "import socket,sys; "
+        "s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); "
+        "s.connect(sys.argv[1]); s.sendall(sys.argv[2].encode()+b'\\n'); "
+        "f=s.makefile('rb'); print(f.readline().decode(),end=''); f.close(); s.close()"
+    )
+    rec = run([
+        "docker", "exec", NAMES[source], "python3", "-c", socket_client,
+        SOURCE_CONTROL_PATH, json.dumps(request, sort_keys=True),
+    ], timeout=timeout, label=f"source-command-{source}-{request.get('op', 'unknown')}")
+    if rec.get("exit_code") != 0 or rec.get("timed_out"):
+        raise RuntimeError(f"{source} source command failed: rc={rec.get('exit_code')} timed_out={rec.get('timed_out')}")
+    try:
+        response = json.loads(rec.get("stdout", ""))
+    except Exception as exc:
+        raise RuntimeError(f"{source} source command returned invalid JSON") from exc
+    if not isinstance(response, dict):
+        raise RuntimeError(f"{source} source command response is not an object")
+    return response
+
