+    if rec.get("exit_code") != 0 or rec.get("timed_out"):
+        return receipt
+    inspected = json_cmd(["docker", "inspect", helper_name], f"helper-inspect-{helper_name}")
+    if not isinstance(inspected, list) or len(inspected) != 1:
+        return receipt
+    item = inspected[0]
+    receipt["container_id"] = item.get("Id")
+    networks = item.get("NetworkSettings", {}).get("Networks", {})
+    external = networks.get(NAMES["external"], {})
+    receipt["peer_ip"] = external.get("IPAddress")
+    if item.get("State", {}).get("Running") is not True:
+        receipt["exit_code"] = 1
+    return receipt
