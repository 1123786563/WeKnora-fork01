+        response = send(source, request)
+        cursors[source] = _validate_helper_start_ack(source, response, phase_id, operation_id, controller_ordinal)
+    result = {**receipt, "operation_id": operation_id, "controller_ordinal": controller_ordinal,
+              "source_cursors": cursors}
+    if dispatch is not None:
+        # This callback is deliberately unreachable until both fsynced source acks
+        # have been checked against the successful host start receipt.
+        result["probe_result"] = dispatch()
+    return result
