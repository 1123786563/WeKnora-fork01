+def _start_helper_operation(helper_name):
+    argv = ["docker", "start", helper_name]
+    rec = run(argv, timeout=15, label=f"helper-start-{helper_name}")
+    receipt = {"argv": argv, "exit_code": rec.get("exit_code"), "timed_out": rec.get("timed_out") is True,
