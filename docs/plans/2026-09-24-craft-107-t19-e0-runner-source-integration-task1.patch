+    boundary = start_helper_and_ack(
+        phase_id, helper_name, operation_id=helper_start_id,
+        controller_ordinal=helper_start_identity[1],
+        dispatch=lambda: docker("exec", helper_name, "sh", "-c", command,
+                                timeout=timeout, label=label),
+    )
+    barrier_identity = _next_controller_identity("barrier", phase_id)
+    source_phase_command("barrier", phase_id, identity=barrier_identity)
+    helper_stop_id, helper_stop_ordinal = _next_controller_identity("docker_stop", phase_id, helper_stop_id)
+    helper_stop = docker("stop", "--time", "2", helper_name, timeout=10,
+                         label=f"phase-{phase_id}-stop-helper")
+    helper_item = json_cmd(["docker", "inspect", helper_name], f"phase-{phase_id}-inspect-helper")
+    helper_operation = {"kind": "operation", "operation": "docker_stop", "operation_id": helper_stop_id,
+                       "controller_ordinal": helper_stop_ordinal, "phase_id": phase_id, "position": "after_barrier",
+                       "argv": helper_stop.get("argv"), "exit_code": helper_stop.get("exit_code"),
+                       "timed_out": helper_stop.get("timed_out", False),
+                       "container_id": helper_item[0].get("Id")}
+    _append_host_operation(helper_operation)
+    if helper_stop.get("exit_code") != 0 or helper_stop.get("timed_out"):
+        raise RuntimeError("helper stop failed after source control phase")
+    return {"process": boundary["probe_result"], "helper_boundary": boundary}
 
 
