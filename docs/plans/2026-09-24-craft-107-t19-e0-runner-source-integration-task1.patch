+    stop_rec = docker("stop", "--time", "2", NAMES["client"], timeout=10, label=f"phase-{phase_id}-stop-client")
+    stop_operation = {"kind": "operation", "operation": "docker_stop", "operation_id": stop_id,
+                      "controller_ordinal": stop_ordinal, "phase_id": phase_id, "position": "before_phase",
+                      "argv": stop_rec.get("argv"), "exit_code": stop_rec.get("exit_code"),
