+def run_source_control_phase(phase_id, command, label, *, timeout=8, case_id="baseline_dns", window="initial"):
+    """Run a bounded control command only after paired source/helper boundaries.
+
+    The helper is stopped only after the source barrier. A failed source ack aborts
+    before docker exec; all cleanup/phase errors remain visible to the caller.
+    """
