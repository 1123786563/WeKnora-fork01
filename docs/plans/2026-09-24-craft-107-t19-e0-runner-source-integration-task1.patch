+def _append_host_operation(operation):
+    """Persist a host operation row before it can authorize source traffic."""
+    path = ART / "host-commands.jsonl"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    encoded = (json.dumps(operation, sort_keys=True, separators=(",", ":")) + "\n").encode()
+    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+    try:
+        os.fchmod(fd, 0o600)
+        with os.fdopen(fd, "ab", closefd=True) as out:
+            fd = -1
+            out.write(encoded)
+            out.flush()
+            os.fsync(out.fileno())
+    finally:
+        if fd >= 0:
+            os.close(fd)
