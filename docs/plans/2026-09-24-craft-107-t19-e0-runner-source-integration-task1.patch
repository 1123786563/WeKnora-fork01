+    inspect_id, inspect_ordinal = _next_controller_identity("client_state_inspect", phase_id)
+    client_inspect = json_cmd(["docker", "inspect", NAMES["client"]], f"phase-{phase_id}-inspect-client")
+    client_item = client_inspect[0]
+    inspect_operation = {"kind": "operation", "operation": "client_state_inspect", "operation_id": inspect_id,
+                         "controller_ordinal": inspect_ordinal, "phase_id": phase_id, "position": "before_phase",
+                         "argv": ["docker", "inspect", NAMES["client"]], "exit_code": 0, "timed_out": False,
+                         "container_id": client_item.get("Id"), "state": client_item.get("State", {})}
+    _append_host_operation(inspect_operation)
+    command_ids = {"case_id": case_id, "window": window, "stop_command_id": stop_id,
+                   "state_inspect_id": inspect_id, "helper_start_id": helper_start_id,
+                   "helper_stop_id": helper_stop_id}
