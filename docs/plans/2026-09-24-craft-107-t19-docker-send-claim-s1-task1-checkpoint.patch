+		VALUES (?, ?, ?, ?, ?, ?, 'intent', ?, ?, ?)`, key.TenantID, key.RunID, key.ActivityKey,
+		"grant-"+key.ActivityKey, "call-"+key.ActivityKey, "reservation-"+key.ActivityKey, revision, now, now).Error)
+}
