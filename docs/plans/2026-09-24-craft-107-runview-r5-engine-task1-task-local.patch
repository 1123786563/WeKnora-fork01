+type runViewBoundedBuffer struct {
+	bytes.Buffer
+	limit int
+}
+
+func (b *runViewBoundedBuffer) Write(p []byte) (int, error) {
+	if b.Len()+len(p) > b.limit {
+		return 0, errors.New("RunView runtime probe output exceeded limit")
+	}
+	return b.Buffer.Write(p)
+}
