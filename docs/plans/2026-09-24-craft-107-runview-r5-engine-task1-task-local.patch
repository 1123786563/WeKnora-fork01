+func stdcopyFrame(stream byte, payload []byte) []byte {
+	var out bytes.Buffer
+	_ = out.WriteByte(stream)
+	_, _ = out.Write([]byte{0, 0, 0})
+	var size [4]byte
+	binary.BigEndian.PutUint32(size[:], uint32(len(payload)))
+	_, _ = out.Write(size[:])
+	_, _ = out.Write(payload)
+	return out.Bytes()
+}
