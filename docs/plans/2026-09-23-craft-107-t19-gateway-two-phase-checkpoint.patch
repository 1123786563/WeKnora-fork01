+func (s *CraftBudgetService) ExtendAndResume(ctx context.Context, scope craft.Scope, runID, key string, extraCalls int, extraCredits commercial.Credits) error {
+	if err := s.authorizeBudgetActor(ctx, scope); err != nil {
+		return err
