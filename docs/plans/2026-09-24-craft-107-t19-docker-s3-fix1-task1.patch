+	result, err := service.Wait(ctx, grantID, "activity-wait-canceled", time.Second)
+	require.ErrorIs(t, err, sandbox.ErrRemoteOperationUnknown)
+	require.Equal(t, sandbox.DockerOutputlessUnknown, result.State)
