+type delayedGatewayBody struct {
+	ctx     context.Context
+	release <-chan struct{}
+	started chan<- context.Context
+	data    string
+	done    bool
+	closed  bool
+}
+
+func (b *delayedGatewayBody) Read(p []byte) (int, error) {
+	if b.done {
+		return 0, io.EOF
+	}
+	b.started <- b.ctx
+	select {
+	case <-b.release:
+	case <-b.ctx.Done():
+		return 0, b.ctx.Err()
+	}
+	b.done = true
+	return copy(p, b.data), nil
+}
+
+func (b *delayedGatewayBody) Close() error { b.closed = true; return nil }
+
+type trackingGatewayBody struct{ closed bool }
+
+func (*trackingGatewayBody) Read([]byte) (int, error) { return 0, io.EOF }
+func (b *trackingGatewayBody) Close() error           { b.closed = true; return nil }
+
+type failingGatewayBody struct{}
+
+func (failingGatewayBody) Read([]byte) (int, error) { return 0, errors.New("response body lost") }
