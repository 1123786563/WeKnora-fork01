+func TestRunViewInputRollbackPreservesReplacementInode(t *testing.T) {
+	inputsDir := t.TempDir()
+	require.NoError(t, os.Mkdir(filepath.Join(inputsDir, "digest"), 0o755))
+	rootFD, err := unix.Open(inputsDir, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	require.NoError(t, err)
+	defer unix.Close(rootFD)
+	dirFD, err := unix.Openat(rootFD, "digest", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	require.NoError(t, err)
+	defer unix.Close(dirFD)
+	fileFD, err := unix.Openat(dirFD, "target.txt", unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0o644)
+	require.NoError(t, err)
+	file := os.NewFile(uintptr(fileFD), "target.txt")
+	_, err = file.Write([]byte("published by us"))
+	require.NoError(t, err)
+	require.NoError(t, file.Close())
+	var ours unix.Stat_t
+	require.NoError(t, unix.Fstatat(dirFD, "target.txt", &ours, unix.AT_SYMLINK_NOFOLLOW))
+	owned := runViewCreatedInput{directory: "digest", name: "target.txt", device: uint64(ours.Dev), inode: uint64(ours.Ino)}
+	target := filepath.Join(inputsDir, "digest", "target.txt")
+	require.NoError(t, os.Rename(target, filepath.Join(inputsDir, "digest", "displaced.txt")))
+	require.NoError(t, os.WriteFile(target, []byte("replacement"), 0o644))
+	// The replacement's identity differs from the published inode, so rollback must leave it alone.
+	require.NoError(t, rollbackRunViewInputWrites(rootFD, []runViewCreatedInput{owned}, nil))
+	got, err := os.ReadFile(target)
+	require.NoError(t, err)
+	if string(got) != "replacement" {
+		t.Fatalf("rollback removed a replacement file: %q", got)
+	}
+}
