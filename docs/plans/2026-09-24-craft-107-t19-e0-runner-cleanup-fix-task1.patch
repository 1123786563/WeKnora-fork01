 def docker(*args, timeout=30, label=None, check=False):
     return run(["docker", *args], timeout=timeout, label=label, check=check)
+
+
+def cleanup_owned_resource(kind, name, invoke=None):
+    """Remove one owned Docker resource and prove its exact absence.
+
+    Docker errors are not interchangeable: only the resource-specific not-found
+    response for this exact name is accepted. Preserve both command records so
+    callers can diagnose a blocked cleanup without guessing from exit status.
+    """
+    if kind == "container":
+        remove_argv = ["docker", "rm", "-f", "-v", name]
+        inspect_argv = ["docker", "inspect", name]
+        remove_missing = f"Error response from daemon: No such container: {name}"
+        inspect_missing = f"error: no such object: {name}"
+        inspect_stdout = "[]"
+    elif kind == "network":
+        remove_argv = ["docker", "network", "rm", name]
+        inspect_argv = ["docker", "network", "inspect", name]
+        remove_missing = f"Error response from daemon: network {name} not found"
+        inspect_missing = remove_missing
+        inspect_stdout = "[]"
+    elif kind == "volume":
+        remove_argv = ["docker", "volume", "rm", name]
+        inspect_argv = ["docker", "volume", "inspect", name]
+        remove_missing = f"Error response from daemon: get {name}: no such volume"
+        inspect_missing = remove_missing
+        inspect_stdout = "[]"
+    else:
+        raise ValueError(f"unsupported owned resource kind: {kind}")
+
+    if invoke is None:
+        invoke = lambda argv, timeout=30, label=None: run(argv, timeout=timeout, label=label)
+    remove = invoke(remove_argv, timeout=10, label=f"cleanup-remove-{kind}-{name}")
+    inspect = invoke(inspect_argv, timeout=10, label=f"cleanup-inspect-{kind}-{name}")
+
+    def completed(record, code):
+        return record.get("exit_code") == code and record.get("timed_out") is not True
+
+    already_absent = (
+        completed(remove, 1)
+        and remove.get("stdout", "") == ""
+        and remove.get("stderr", "").strip() == remove_missing
+    )
+    removed = completed(remove, 0)
+    inspect_absent = (
+        completed(inspect, 1)
+        and inspect.get("stdout", "").strip() == inspect_stdout
+        and inspect.get("stderr", "").strip() == inspect_missing
+    )
+    return {
+        "kind": kind,
+        "resource": name,
+        "removed": removed,
+        "already_absent": already_absent,
+        "inspect_absent": inspect_absent,
+        "ok": (removed or already_absent) and inspect_absent,
+        "remove": remove,
+        "inspect": inspect,
+    }
 
 
