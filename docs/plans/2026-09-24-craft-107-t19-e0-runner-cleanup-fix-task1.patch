+
+                queue = [self.rec([], 1, stderr=not_found.replace(self.RESOURCE, "other")),
+                         self.rec([], 1, stdout="[]", stderr=not_found)]
+                result = run_v2.cleanup_owned_resource(kind, self.RESOURCE, invoke)
+                self.assertFalse(result["ok"])
