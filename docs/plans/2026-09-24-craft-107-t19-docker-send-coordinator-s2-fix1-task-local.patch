+
+func testCraftDockerSendClaimSerializesConcurrentRunPause(t *testing.T, db *gorm.DB) {
+	ctx := context.Background()
+	key, revision := craftDockerSendFixture(t, db, "docker-run-pause-race", "activity")
+	receipt := DockerExecReceipt{Provider: "docker", ContainerID: "container-pause-race", ExecID: "exec-pause-race"}
+	store := NewCraftDockerSendClaimRepository(db)
+	require.NoError(t, store.BindDockerExecReceipt(ctx, key, revision, receipt))
+
+	// Pause owns the Run row first. A concurrent claim must wait for that
+	// transaction, then see the committed non-executable status and reject.
+	pauseDB := reopenRunDB(t, db)
+	pauseTx := pauseDB.Begin()
+	require.NoError(t, pauseTx.Error)
+	require.NoError(t, pauseTx.Table("agent_runs").Where("tenant_id = ? AND run_id = ?", key.TenantID, key.RunID).
+		Updates(map[string]any{"status": "waiting_user", "revision": revision + 1}).Error)
+	started := make(chan struct{})
+	done := make(chan struct {
+		claimed bool
+		err     error
+	}, 1)
+	go func() {
+		close(started)
+		claimed, err := store.ClaimDockerExecSend(ctx, key, revision, receipt)
+		done <- struct {
+			claimed bool
+			err     error
+		}{claimed: claimed, err: err}
+	}()
+	<-started
+	select {
+	case result := <-done:
+		t.Fatalf("claim completed before Run pause committed: claimed=%v err=%v", result.claimed, result.err)
+	case <-time.After(150 * time.Millisecond):
+	}
+	require.NoError(t, pauseTx.Commit().Error)
+	result := <-done
+	require.False(t, result.claimed)
+	require.ErrorIs(t, result.err, craft.ErrConflict)
+	assertCraftDockerSendPreparedAndHeld(t, db, key, revision, true)
+}
