+			"tenant_id = ? AND run_id = ? AND activity_key = ?", key.TenantID, key.RunID, key.ActivityKey).Count(&count).Error)
+		require.EqualValues(t, 1, count)
+		require.Error(t, db.Table("craft_charge_start_journal").Where(
+			"tenant_id = ? AND run_id = ? AND activity_key = ?", key.TenantID, key.RunID, key.ActivityKey).Update("protocol", "legacy_callback").Error,
+			"protocol constraint rejects unrecognized ownership values")
+	})
