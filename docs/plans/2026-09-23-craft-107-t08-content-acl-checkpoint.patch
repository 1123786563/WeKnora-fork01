+func TestCraftSessionTaskAccessRejectsStaleMembershipAndAdminWithoutGrant(t *testing.T) {
+	env, access := newCraftTaskACLEnv(t)
+	ws := createCraftSession(t, env, "u1", "stale-acl-task", "private task", "web")
