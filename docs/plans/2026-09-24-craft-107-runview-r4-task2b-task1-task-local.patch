+	require.NoError(t, sqlDB.QueryRow(`SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = 'craft_candidates'`).Scan(&tables))
+	require.Zero(t, tables)
+	require.NoError(t, m.Up())
+	require.NoError(t, sqlDB.QueryRow(`SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = 'craft_candidates'`).Scan(&tables))
