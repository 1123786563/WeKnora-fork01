-// Advance is implemented with the collection authority in S2. Until then the
-// interface safely rejects writes rather than implying SQL proves quiescence.
-func (s *CraftDraftHeadStore) Advance(context.Context, craft.Scope, string, int64, string, []craft.File) (craft.DraftHead, error) {
