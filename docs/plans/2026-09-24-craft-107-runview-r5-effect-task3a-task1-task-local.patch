+func (s *admittedRuntimeStoreFake) Load(_ context.Context, key craft.RunViewKey) (craft.RunView, error) {
+	if s.view.Key != key {
+		return craft.RunView{}, craft.ErrConflict
+	}
+	return s.view, nil
