{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "WeKnora Lite",
  "outputfilename": "WeKnora Lite",
  "frontend:dir": "../../apps/desktop",
  "frontend:install": "pnpm --dir ../.. install --frozen-lockfile",
  "frontend:build": "pnpm --dir ../.. build:desktop-renderer",
  "frontend:dev": "pnpm --dir ../.. --filter @weknora/desktop-renderer dev",
  "wailsjsdir": "../../apps/desktop/src/wailsjs",
  "author": {
    "name": "WeKnora Team",
    "email": ""
  },
  "info": {
    "companyName": "Tencent",
    "productName": "WeKnora Lite",
    "productVersion": "1.0.0",
    "copyright": "Copyright 2026 Tencent",
    "comments": "WeKnora Desktop Edition"
  },
  "mac": {
    "category": "public.app-category.productivity",
    "titlebar": "hiddenInset"
  }
}
