{
  "expo": {
    "name": "WeKnora",
    "slug": "weknora-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "weknora",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.weknora.mobile",
      "supportsTablet": true,
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "com.weknora.mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "VIBRATE",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "WeKnora uses the microphone for voice dictation and live voice sessions."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-asset"
    ]
  }
}
