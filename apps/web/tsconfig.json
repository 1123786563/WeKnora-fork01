{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@weknora/api-client": ["../../packages/api-client/src/index.ts"],
      "@weknora/contracts": ["../../packages/contracts/src/index.ts"],
      "@weknora/core/craft/controller": ["../../packages/core/src/craft/controller.ts"],
      "@weknora/domain": ["../../packages/domain/src/query-key.ts"],
      "@weknora/domain/scope": ["../../packages/domain/src/scope.ts"],
      "@weknora/domain/craft/state": ["../../packages/domain/src/craft/state.ts"],
      "@weknora/views/craft/home": ["../../packages/views/src/craft/home.tsx"],
      "@weknora/views/craft/workbench": ["../../packages/views/src/craft/workbench.tsx"],
      "@weknora/views/craft/preview": ["../../packages/views/src/craft/preview.tsx"],
      "@weknora/views/craft/files": ["../../packages/views/src/craft/files.tsx"],
      "@weknora/views/craft/presentation": ["../../packages/views/src/craft/presentation.ts"],
      "@weknora/ui": ["../../packages/ui/src/index.tsx"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
