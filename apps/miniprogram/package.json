    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@weknora/api-client": "workspace:*",
    "@weknora/contracts": "workspace:*",
    "@weknora/domain": "workspace:*",
    "abort-controller": "3.0.0",
    "core-js": "3.41.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "22.14.0",
    "@types/react": "18.3.18",
    "babel-loader": "8.2.1",
    "babel-preset-taro": "4.2.1",
    "sass": "1.86.0",
    "typescript": "5.8.3",
    "webpack": "5.98.0"
  }
